<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full screen background -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/dashboardbg"
        android:contentDescription="@null" />

    <!-- Dark overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#80000000" />

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="30dp">

            <!-- ========================= -->
            <!-- HEADER -->
            <!-- ========================= -->

            <RelativeLayout
                android:id="@+id/dashboardHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="@dimen/dashboard_header_padding_top"
                android:paddingBottom="12dp">

                <!-- Back button -->
                <ImageView
                    android:id="@+id/backButton"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentTop="true"
                    android:layout_marginTop="6dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_back"
                    android:background="@drawable/bg_back_button"
                    android:contentDescription="Go back"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Title -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/backButton"
                    android:layout_toStartOf="@id/notificationButton"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="14dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My "
                        android:textColor="#FFFFFF"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Bookings"
                        android:textColor="#F2C300"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Notification -->
                <ImageView
                    android:id="@+id/notificationButton"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_alignParentTop="true"
                    android:padding="6dp"
                    android:src="@drawable/notification"
                    android:contentDescription="Notifications"
                    android:clickable="true"
                    android:focusable="true" />

            </RelativeLayout>


            <!-- ========================= -->
            <!-- HISTORY TABS -->
            <!-- ========================= -->

            <LinearLayout
                android:id="@+id/historyTabs"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Booking History -->
                <TextView
                    android:id="@+id/bookingHistoryButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/history_tab_selected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Active Bookings"
                    android:textColor="@android:color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <!-- Pending History -->
                <TextView
                    android:id="@+id/pendingHistoryButton"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/history_tab_unselected"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="Booking History"
                    android:textColor="#B8C8C0"
                    android:textSize="13sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- ========================= -->
            <!-- HISTORY FRAGMENT CONTAINER -->
            <!-- ========================= -->

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/historyFragmentContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginStart="16dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:layout_weight="1" />

        </LinearLayout>

    </ScrollView>

</FrameLayout>
